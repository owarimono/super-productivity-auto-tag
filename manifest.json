{
  "id": "auto-tag-manager",
  "name": "Auto Tag Manager",
  "version": "2.1.1",
  "description": "Automatically applies tags to tasks based on keywords in the task title.",
  "manifestVersion": 1,
  "minSupVersion": "18.8.0",
  "author": "Owarimono",
  "icon": "icon.svg",
  "iFrame": true,
  "uiKit": true,
  "isSkipMenuEntry": true,
  "permissions": [
    "registerHeaderButton",
    "showIndexHtmlAsView",
    "persistDataSynced",
    "loadSyncedData",
    "getAllTags",
    "updateTask"
  ],
  "hooks": ["taskCreated", "taskUpdate"]
}
